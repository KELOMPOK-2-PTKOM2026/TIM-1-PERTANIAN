# Salin ke `.env` dan isi dari dashboard Neon (https://neon.tech)
# Tanpa DATABASE_URL, aplikasi berjalan dalam MODE MOCK (data contoh lokal) — `npm run build` tetap hijau.
# Untuk migrate: bila koneksi pooling bermasalah, isi DATABASE_URL dengan connection string direct Neon.
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require"

# Auth (Fase 2): generate dengan `npx auth secret`
AUTH_SECRET=""
# Password admin awal untuk `npm run db:seed` (default dev: admin12345)
SEED_ADMIN_PASSWORD=""
